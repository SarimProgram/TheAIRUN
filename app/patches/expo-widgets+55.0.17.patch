     ])
 
     return .result()
   }
 }
+
+enum LiveActivityInteractionQueue {
+  static let storageKey = "__expo_widgets_pending_live_activity_interactions"
+  static let maxStored = 50
+  private static let lock = NSLock()
+
+  static func append(source: String, target: String, timestamp: Int) {
+    lock.lock()
+    defer { lock.unlock() }
+    var items = (WidgetsStorage.getArray(forKey: storageKey) as? [[String: Any]]) ?? []
+    items.append(["source": source, "target": target, "timestamp": timestamp])
+    if items.count > maxStored {
+      items.removeFirst(items.count - maxStored)
+    }
+    WidgetsStorage.set(items, forKey: storageKey)
+  }
+
+  static func drain() -> [[String: Any]] {
+    lock.lock()
+    defer { lock.unlock() }
+    let items = (WidgetsStorage.getArray(forKey: storageKey) as? [[String: Any]]) ?? []
+    WidgetsStorage.removeObject(forKey: storageKey)
+    return items
+  }
+
+  static func pending() -> [[String: Any]] {
+    lock.lock()
+    defer { lock.unlock() }
+    return (WidgetsStorage.getArray(forKey: storageKey) as? [[String: Any]]) ?? []
+  }
+
+  static func acknowledge(source: String, target: String, timestamp: Int) {
+    lock.lock()
+    defer { lock.unlock() }
+    let items = (WidgetsStorage.getArray(forKey: storageKey) as? [[String: Any]]) ?? []
+    let remaining = items.filter {
+      !(($0["source"] as? String) == source && ($0["target"] as? String) == target
+        && ($0["timestamp"] as? Int) == timestamp)
+    }
+    WidgetsStorage.set(remaining, forKey: storageKey)
+  }
+
+  @available(iOS 16.2, *)
+  static func endActivity(id: String, lastAction: String) async {
+    guard let activity = Activity<LiveActivityAttributes>.activities.first(where: { $0.id == id }) else {
+      return
+    }
+
+    let state = activity.content.state
+    var props = (try? JSONSerialization.jsonObject(with: Data(state.props.utf8))) as? [String: Any] ?? [:]
+    props["lastAction"] = lastAction
+    let propsString = (try? JSONSerialization.data(withJSONObject: props))
+      .flatMap { String(data: $0, encoding: .utf8) } ?? state.props
+
+    await activity.end(
+      ActivityContent(state: LiveActivityAttributes.ContentState(name: state.name, props: propsString), staleDate: nil),
+      dismissalPolicy: .after(Date().addingTimeInterval(4))
+    )
+  }
+}
