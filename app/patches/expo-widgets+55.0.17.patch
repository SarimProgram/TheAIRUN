diff --git a/node_modules/expo-widgets/ios/Widgets/RemoteFeed.swift b/node_modules/expo-widgets/ios/Widgets/RemoteFeed.swift
new file mode 100644
index 0000000..a2b2414
--- /dev/null
+++ b/node_modules/expo-widgets/ios/Widgets/RemoteFeed.swift
@@ -0,0 +1,178 @@
+import Foundation
+import WidgetKit
+
+/// A server endpoint the widget extension reads its timeline from when WidgetKit reloads it,
+/// which is what a WidgetKit push (iOS 26+) does: the push carries no data, only "content changed".
+///
+/// Response: `{ "entries": [{ "timestamp": ms, "props": {...} }], "files": [{ "name", "url", "auth" }], "prunePrefix"? }`.
+/// Files are downloaded into the shared app group; any string prop `shared-container:<name>` becomes
+/// that file's URL, or "" when it isn't there.
+enum WidgetsRemoteFeed {
+  static let pushTokenKey = "__expo_widgets_push_token"
+  static let sharedPrefix = "shared-container:"
+
+  struct Feed {
+    let url: URL
+    let token: String
+    let pushTokenUrl: URL?
+  }
+
+  static func feedKey(_ name: String) -> String { "__expo_widgets_\(name)_remote_feed" }
+
+  static func load(name: String) -> Feed? {
+    guard let dict = WidgetsStorage.getDictionary(forKey: feedKey(name)),
+          let url = (dict["url"] as? String).flatMap(URL.init(string:)),
+          let token = dict["token"] as? String, !token.isEmpty
+    else { return nil }
+    return Feed(url: url, token: token, pushTokenUrl: (dict["pushTokenUrl"] as? String).flatMap(URL.init(string:)))
+  }
+
+  static func allFeeds() -> [Feed] {
+    guard let defaults = WidgetsStorage.defaults else { return [] }
+    return defaults.dictionaryRepresentation().keys
+      .filter { $0.hasPrefix("__expo_widgets_") && $0.hasSuffix("_remote_feed") }
+      .compactMap { key in
+        let name = String(key.dropFirst("__expo_widgets_".count).dropLast("_remote_feed".count))
+        return load(name: name)
+      }
+  }
+
+  static var containerURL: URL? {
+    guard let group = WidgetsStorage.appGroupIdentifier else { return nil }
+    return FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: group)
+  }
+
+  /// Fetches the feed and stores its entries as the widget's timeline. Always calls `done`;
+  /// on any failure the previously stored timeline stays in place.
+  static func refresh(name: String, feed: Feed, done: @escaping @Sendable () -> Void) {
+    var request = URLRequest(url: feed.url, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 12)
+    request.setValue("Bearer \(feed.token)", forHTTPHeaderField: "Authorization")
+    URLSession.shared.dataTask(with: request) { data, response, _ in
+      let status = (response as? HTTPURLResponse)?.statusCode ?? 0
+      if status == 401 || status == 410 {
+        // Signed out or the device was unregistered: stop showing someone else's food.
+        WidgetsStorage.removeObject(forKey: feedKey(name))
+        WidgetsStorage.removeObject(forKey: "__expo_widgets_\(name)_timeline")
+        done()
+        return
+      }
+      guard status == 200, let data,
+            let json = (try? JSONSerialization.jsonObject(with: data)) as? [String: Any],
+            let rawEntries = json["entries"] as? [[String: Any]]
+      else { done(); return }
+
+      let files = (json["files"] as? [[String: Any]]) ?? []
+      download(files: files, feed: feed) {
+        if let prefix = json["prunePrefix"] as? String, !prefix.isEmpty {
+          prune(prefix: prefix, keeping: Set(files.compactMap { $0["name"] as? String }))
+        }
+        let entries: [[String: Any]] = rawEntries.compactMap { entry in
+          guard let timestamp = (entry["timestamp"] as? NSNumber)?.intValue,
+                let props = entry["props"] as? [String: Any] else { return nil }
+          return ["timestamp": timestamp, "props": resolve(sanitize(props) as? [String: Any] ?? [:])]
+        }
+        WidgetsStorage.set(entries, forKey: "__expo_widgets_\(name)_timeline")
+        done()
+      }
+    }.resume()
+  }
+
+  private static func download(files: [[String: Any]], feed: Feed, done: @escaping @Sendable () -> Void) {
+    guard let container = containerURL else { done(); return }
+    let group = DispatchGroup()
+    for file in files {
+      guard let name = file["name"] as? String, isSafeFileName(name),
+            let url = (file["url"] as? String).flatMap(URL.init(string:)) else { continue }
+      let target = container.appendingPathComponent(name)
+      if FileManager.default.fileExists(atPath: target.path) { continue }
+      var request = URLRequest(url: url, timeoutInterval: 12)
+      if file["auth"] as? Bool == true {
+        request.setValue("Bearer \(feed.token)", forHTTPHeaderField: "Authorization")
+      }
+      group.enter()
+      URLSession.shared.downloadTask(with: request) { location, response, _ in
+        defer { group.leave() }
+        guard let location, (response as? HTTPURLResponse)?.statusCode == 200 else { return }
+        try? FileManager.default.removeItem(at: target)
+        try? FileManager.default.moveItem(at: location, to: target)
+      }.resume()
+    }
+    group.notify(queue: .global(), execute: done)
+  }
+
+  private static func prune(prefix: String, keeping: Set<String>) {
+    guard let container = containerURL,
+          let names = try? FileManager.default.contentsOfDirectory(atPath: container.path) else { return }
+    for name in names where name.hasPrefix(prefix) && !keeping.contains(name) {
+      try? FileManager.default.removeItem(at: container.appendingPathComponent(name))
+    }
+  }
+
+  private static func isSafeFileName(_ name: String) -> Bool {
+    !name.isEmpty && !name.contains("/") && !name.contains("..")
+  }
+
+  /// UserDefaults rejects NSNull, so nulls from JSON are dropped before the timeline is stored.
+  private static func sanitize(_ value: Any) -> Any? {
+    switch value {
+    case is NSNull: return nil
+    case let dict as [String: Any]: return dict.compactMapValues { sanitize($0) }
+    case let array as [Any]: return array.compactMap { sanitize($0) }
+    default: return value
+    }
+  }
+
+  private static func resolve(_ props: [String: Any]) -> [String: Any] {
+    props.mapValues { value in
+      guard let string = value as? String, string.hasPrefix(sharedPrefix) else { return value }
+      let name = String(string.dropFirst(sharedPrefix.count))
+      guard isSafeFileName(name), let target = containerURL?.appendingPathComponent(name),
+            FileManager.default.fileExists(atPath: target.path) else { return "" }
+      return target.absoluteString
+    }
+  }
+
+  /// Lets the server learn a rotated push token without waiting for the app to open.
+  static func reportPushToken(_ token: String) {
+    for feed in allFeeds() {
+      guard let url = feed.pushTokenUrl,
+            let body = try? JSONSerialization.data(withJSONObject: ["pushToken": token]) else { continue }
+      var request = URLRequest(url: url, timeoutInterval: 12)
+      request.httpMethod = "POST"
+      request.setValue("Bearer \(feed.token)", forHTTPHeaderField: "Authorization")
+      request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+      request.httpBody = body
+      URLSession.shared.dataTask(with: request).resume()
+    }
+  }
+}
+
+#if compiler(>=6.2)
+@available(iOS 26.0, *)
+public struct ExpoWidgetsPushHandler: WidgetPushHandler {
+  public init() {}
+
+  public func pushTokenDidChange(_ pushInfo: WidgetPushInfo, widgets: [WidgetInfo]) {
+    let token = pushInfo.token.map { String(format: "%02x", $0) }.joined()
+    if WidgetsStorage.getString(forKey: WidgetsRemoteFeed.pushTokenKey) != token {
+      WidgetsStorage.set(token, forKey: WidgetsRemoteFeed.pushTokenKey)
+      WidgetsRemoteFeed.reportPushToken(token)
+    }
+  }
+}
+#endif
+
+public extension WidgetConfiguration {
+  /// Registers the widget for WidgetKit push updates on iOS 26+; a no-op on earlier systems.
+  func expoWidgetsPushHandler() -> some WidgetConfiguration {
+    #if compiler(>=6.2)
+    if #available(iOS 26.0, *) {
+      return self.pushHandler(ExpoWidgetsPushHandler.self)
+    } else {
+      return self
+    }
+    #else
+    return self
+    #endif
+  }
+}
