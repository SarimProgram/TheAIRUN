   func perform() async throws -> some IntentResult {
+    let timestamp = Int(Date().timeIntervalSince1970 * 1000)
+
+    if let source, let target {
+      // The JS listener is often not running yet (the intent can cold-launch the app in the background),
+      // so the tap is persisted until JS saves its effects and explicitly acknowledges it.
+      LiveActivityInteractionQueue.append(source: source, target: target, timestamp: timestamp)
+
+      // `end:<action>` buttons resolve the card immediately: the layout gets `lastAction` to render its
+      // confirmation state, then the system removes it a few seconds later.
+      if target.hasPrefix("end:"), #available(iOS 16.2, *) {
+        await LiveActivityInteractionQueue.endActivity(id: source, lastAction: target)
+      }
+    }
